             if self.activation_checkpointing and self.training:
@@ -197,7 +205,15 @@ class PairformerModule(nn.Module):
                     use_kernels,
                 )
             else:
-                s, z = layer(s, z, mask, pair_mask, chunk_size_tri_attn, use_kernels)
+                s, z = layer(
+                    s,
