@@ -606,7 +615,12 @@ def get_template_records_from_matching(
     for chain_id, template_chain_id in zip(chain_ids, template_chain_ids):
         # Align the sequences
         chain_seq = sequences[chain_id]
-        template_seq = template_sequences[template_chain_id]
+        template_seq = template_sequences.get(template_chain_id, "")
+
+        # Skip if template has no sequence (e.g., ligands)
+        if not template_seq:
+            continue
+
         alignments = get_local_alignments(chain_seq, template_seq)
         for alignment in alignments:
             template_record = TemplateInfo(
@@ -1599,6 +1613,11 @@ def parse_boltz_schema(  # noqa: C901, PLR0915, PLR0912
     # Get protein sequences in this YAML
     protein_seqs = {name: chains[name].sequence for name in protein_chains}
 
+    # Get all sequences for template matching (including empty sequences for ligands)
+    all_sequences = {}
+    for name, chain in chains.items():
+        all_sequences[name] = chain.sequence if chain.sequence is not None else ""
+
     # Parse templates
     template_schema = schema.get("templates", [])
     if template_schema and not boltz_2:
@@ -1706,7 +1725,7 @@ def parse_boltz_schema(  # noqa: C901, PLR0915, PLR0912
                 get_template_records_from_matching(
                     template_id=template_id,
                     chain_ids=chain_ids,
-                    sequences=protein_seqs,
+                    sequences=all_sequences,
                     template_chain_ids=template_chain_ids,
                     template_sequences=parsed_template.sequences,
                     force=force,
@@ -1718,7 +1737,7 @@ def parse_boltz_schema(  # noqa: C901, PLR0915, PLR0912
                 get_template_records_from_search(
                     template_id=template_id,
                     chain_ids=chain_ids,
-                    sequences=protein_seqs,
