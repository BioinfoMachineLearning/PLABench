         return s, z
 
 
@@ -237,6 +253,7 @@ class PairformerNoSeqLayer(nn.Module):
         use_kernels: bool = False,
         use_cuequiv_mul: bool = False,
         use_cuequiv_attn: bool = False,
+        chunk_size_transition_z: Optional[int] = None,
     ) -> Tensor:
