diff --git a/src/boltz/model/modules/confidencev2.py b/src/boltz/model/modules/confidencev2.py
index 3dedc5f..1775894 100644
--- a/src/boltz/model/modules/confidencev2.py
+++ b/src/boltz/model/modules/confidencev2.py
@@ -95,6 +95,7 @@ class ConfidenceModule(nn.Module):
         self.pairformer_stack = PairformerModule(
             token_s,
             token_z,
+            chunk_transition_z=True,
             **pairformer_args,
         )
         self.return_latent_feats = return_latent_feats
@@ -160,30 +161,37 @@ class ConfidenceModule(nn.Module):
         if self.add_s_input_to_s:
             s = s + self.s_input_to_s(s_inputs)
 
+        # z_norm returns a fresh tensor, so the conditioning terms below can be
+        # accumulated in place.  The caller's z is never touched, and under
+        # run_sequentially each sample re-enters here and gets its own copy.
+        # Every `z = z + term` used to allocate another (1, n, n, token_z)
+        # float32 buffer -- 5.2 GiB apiece at 3308 tokens -- while the previous
+        # one was still bound, which is what pushed the 3280-token arms over 80 GB.
         z = self.z_norm(z)
 
         if self.add_z_input_to_z:
-            relative_position_encoding = self.rel_pos(feats)
-            z = z + relative_position_encoding
-            z = z + self.token_bonds(feats["token_bonds"].float())
+            z += self.rel_pos(feats)
+            z += self.token_bonds(feats["token_bonds"].float())
             if self.bond_type_feature:
-                z = z + self.token_bonds_type(feats["type_bonds"].long())
-            z = z + self.contact_conditioning(feats)
+                z += self.token_bonds_type(feats["type_bonds"].long())
+            z += self.contact_conditioning(feats)
 
         s = s.repeat_interleave(multiplicity, 0)
 
-        z = (
-            z
-            + self.s_to_z(s_inputs)[:, :, None, :]
-            + self.s_to_z_transpose(s_inputs)[:, None, :, :]
-        )
+        z += self.s_to_z(s_inputs)[:, :, None, :]
+        z += self.s_to_z_transpose(s_inputs)[:, None, :, :]
         if self.add_s_to_z_prod:
-            z = z + self.s_to_z_prod_out(
+            z += self.s_to_z_prod_out(
                 self.s_to_z_prod_in1(s_inputs)[:, :, None, :]
                 * self.s_to_z_prod_in2(s_inputs)[:, None, :, :]
             )
 
-        z = z.repeat_interleave(multiplicity, 0)
+        # run_sequentially re-enters with multiplicity == 1, where this is a
+        # value-preserving copy of a (1, n, n, token_z) float32 buffer -- 5.2 GiB
+        # at 3308 tokens, for nothing.  z is already private to this call (it
+        # came out of z_norm above), so skipping the copy is safe.
+        if multiplicity > 1:
+            z = z.repeat_interleave(multiplicity, 0)
         s_inputs = s_inputs.repeat_interleave(multiplicity, 0)
 
         token_to_rep_atom = feats["token_to_rep_atom"]
@@ -197,7 +205,11 @@ class ConfidenceModule(nn.Module):
         d = torch.cdist(x_pred_repr, x_pred_repr)
         distogram = (d.unsqueeze(-1) > self.boundaries).sum(dim=-1).long()
         distogram = self.dist_bin_pairwise_embed(distogram)
-        z = z + distogram
+        # Accumulate in place and drop the embedding immediately: both are
+        # full (1, n, n, token_z) float32 buffers, and the pairformer stack
+        # below is what actually runs out of room.
+        z += distogram
+        del distogram
 
         mask = feats["token_pad_mask"].repeat_interleave(multiplicity, 0)
         pair_mask = mask[:, :, None] * mask[:, None, :]
diff --git a/src/boltz/model/modules/trunkv2.py b/src/boltz/model/modules/trunkv2.py
