index cade3c2..51d905d 100644
--- a/src/boltz/data/parse/mmcif.py
+++ b/src/boltz/data/parse/mmcif.py
@@ -581,16 +581,29 @@ def parse_polymer(  # noqa: C901, PLR0915, PLR0912
 
     # Get coordinates and masks
     i = 0
+    seq_idx = 0  # Track sequence index separately
     ref_res = set(const.tokens)
     parsed = []
     for j, match in enumerate(result.match_string):
+        # Skip gaps in alignment
+        if match == '-':
+            continue
+
+        # For all other characters (match '|', mismatch '.', or space ' ')
+        # we need to advance through the sequence
+        if seq_idx >= len(sequence):
+            # We've processed all sequences, remaining are just alignment padding
+            break
+
         # Get residue name from sequence
-        res_name = sequence[j]
+        res_name = sequence[seq_idx]
+        seq_idx += 1
 
         # Check if we have a match in the structure
         res = None
         name_to_atom = {}
 
+        # '|' means exact match, '.' means mismatch, ' ' means no alignment
         if match == "|":
             # Get pdb residue
             res = polymer[i]
@@ -603,6 +616,13 @@ def parse_polymer(  # noqa: C901, PLR0915, PLR0912
 
             # Increment polymer index
             i += 1
+        elif match == '.':
+            # Mismatch - structure has different residue than sequence
+            # Still need to get the structure residue if within bounds
+            if i < len(polymer):
+                res = polymer[i]
+                name_to_atom = {a.name.upper(): a for a in res}
+                i += 1
 
         # Map MSE to MET, put the selenium atom in the sulphur column
         if res_name == "MSE":
@@ -617,7 +637,7 @@ def parse_polymer(  # noqa: C901, PLR0915, PLR0912
                 residue = parse_ccd_residue(
                     name=res_name,
                     ref_mol=modified_mol,
-                    res_idx=j,
+                    res_idx=seq_idx - 1,  # seq_idx was already incremented
                     gemmi_mol=res,
                     is_covalent=True,
                 )
@@ -696,7 +716,7 @@ def parse_polymer(  # noqa: C901, PLR0915, PLR0912
                 type=const.token_ids[res_name],
                 atoms=atoms,
                 bonds=[],
-                idx=j,
+                idx=seq_idx - 1,  # seq_idx was already incremented
                 atom_center=atom_center,
                 atom_disto=atom_disto,
                 is_standard=True,
